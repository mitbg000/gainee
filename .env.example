# ======================== Gainee configuration ========================
# Run `bash scripts/init-env.sh` to create .env interactively.

# --- App ---
PORT=3000
# Default UI language before the user picks one: en | vi
DEFAULT_LOCALE=vi
# Time zone for streaks, reminders, daily stats
TZ=Asia/Ho_Chi_Minh

# --- MySQL (create the database in aaPanel → Databases, charset utf8mb4) ---
DATABASE_URL=mysql://gainee:CHANGE_ME@127.0.0.1:3306/gainee
DATABASE_POOL_SIZE=5

# --- Security ---
# Login username (case-insensitive)
APP_USERNAME=admin
# Login password hash: node dist/hash-password.js   (or: npm run hash-password)
APP_PASSWORD_HASH=
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   ← back this up! Without it, saved AI keys cannot be decrypted.
ENCRYPTION_KEY=

# --- Files (word images, uploaded PDFs, audio). Keep it OUTSIDE the app folder. ---
UPLOAD_DIR=/www/wwwroot/gainee-data/uploads
